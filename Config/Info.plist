<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ClickTrivia usa la rete locale solo per far giocare insieme dispositivi vicini nella stessa stanza. Nessun dato lascia i vostri dispositivi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_clicktrivia._tcp</string>
		<string>_clicktrivia._udp</string>
	</array>
	<!-- Export compliance: l'app non implementa algoritmi crittografici propri e
	     usa solo la cifratura fornita dal sistema operativo e dai servizi Apple
	     (HTTPS, cifratura di trasporto di MultipeerConnectivity, CloudKit lato
	     Apple). Rientra quindi nell'esenzione standard. Vedi CLAUDE.md,
	     "Export compliance". -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
