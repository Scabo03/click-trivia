# Fastfile — ClickTrivia
#
# Quattro lane:
#   • fetch_signing     — installa certificato e profilo esistenti (readonly). Default sicuro.
#   • setup_signing     — crea/riallinea certificati e profilo via Match. ECCEZIONALE, vedi CLAUDE.md.
#   • build_only        — archive + export firmati, senza upload. Verifica la firma.
#   • testflight_upload — build, archive, export e upload TestFlight in un colpo solo
#
# La pipeline di build usa `xcodebuild` diretto (archive + export, senza
# -destination, piattaforma device forzata) e `xcrun altool` per l'upload: è la
# pipeline collaudata sugli altri progetti iOS dell'utente. Non si usa gym() di
# proposito, perché su progetti reali questo flusso si è dimostrato più affidabile.

require "fileutils"
require "base64"
require "spaceship"

default_platform(:ios)

# ── Config ────────────────────────────────────────────────────────────────────
# Identità del progetto: FISSA, non da env. Le credenziali condivise vivono in un
# file env multi-progetto (~/Developer/private_keys/scabo_deploy.env) che porta un
# APP_IDENTIFIER / MATCH_GIT_URL di un ALTRO progetto: pinnandoli qui evitiamo che
# match colpisca l'app o il repo certificati sbagliati.
APP_IDENTIFIER = "com.scabo.click-trivia"
# Repo certificati condiviso con Lumar Lounge: vedi la nota nel Matchfile: il
# tetto di 3 certificati Apple Distribution dell'account è saturo, quindi si
# riusa un certificato già archiviato invece di generarne un quarto.
CERTS_GIT_URL  = "https://github.com/Scabo03/lumar-lounge-certs.git"
# Valori a livello di account, condivisi tra i progetti: ok leggerli da env.
TEAM_ID        = ENV["APPLE_TEAM_ID"] || "D2KQYQ8YU8"
SCHEME         = "ClickTrivia"
PROJECT_ROOT   = File.expand_path("..", __dir__)
PROJECT_PATH   = File.join(PROJECT_ROOT, "ClickTrivia.xcodeproj")
BUILD_DIR      = File.join(PROJECT_ROOT, "build")
ARCHIVE_PATH   = File.join(BUILD_DIR, "ClickTrivia.xcarchive")
EXPORT_PATH    = File.join(BUILD_DIR, "export")
PROFILE_NAME   = "match AppStore #{APP_IDENTIFIER}"

# ── Helper: App Store Connect API key ────────────────────────────────────────
# Usa APP_STORE_CONNECT_API_KEY_CONTENT (contenuto del .p8, base64 o PEM) se
# presente, altrimenti il file puntato da APP_STORE_CONNECT_API_KEY_PATH
# (sulla macchina dell'utente: ~/Developer/private_keys/AuthKey_MGW9GC97HV.p8).
# La chiave NON vive nel repo: si referenzia sempre per percorso esterno.
def asc_api_key
  key_id    = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]

  if (content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]) && !content.empty?
    app_store_connect_api_key(
      key_id:                key_id,
      issuer_id:             issuer_id,
      key_content:           content,
      is_key_content_base64: !content.include?("BEGIN PRIVATE KEY"),
      in_house:              false,
    )
  else
    path = File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "~/AuthKey.p8")
    UI.user_error!("API key non trovata: #{path}. Imposta APP_STORE_CONNECT_API_KEY_PATH o APP_STORE_CONNECT_API_KEY_CONTENT.") unless File.exist?(path)
    app_store_connect_api_key(
      key_id:       key_id,
      issuer_id:    issuer_id,
      key_filepath: path,
      in_house:     false,
    )
  end
end

# Materializza la .p8 dove `xcrun altool` la cerca:
# ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8
def ensure_altool_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  dir    = File.expand_path("~/.appstoreconnect/private_keys")
  FileUtils.mkdir_p(dir)
  dest = File.join(dir, "AuthKey_#{key_id}.p8")
  return dest if File.exist?(dest)

  if (content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]) && !content.empty?
    data = content.include?("BEGIN PRIVATE KEY") ? content : Base64.decode64(content)
    File.write(dest, data)
  else
    src = File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "~/AuthKey.p8")
    UI.user_error!("API key non trovata: #{src}") unless File.exist?(src)
    FileUtils.cp(src, dest)
  end
  dest
end

# match mappa automaticamente l'env APP_STORE_CONNECT_API_KEY_PATH sull'opzione
# `api_key_path`, che va in conflitto con l'`api_key` (hash) che gli passiamo.
# Togliamo temporaneamente quell'env attorno alla chiamata a match e la
# ripristiniamo dopo (serve ad altool nello step di upload).
def without_api_key_path_env
  saved = ENV.delete("APP_STORE_CONNECT_API_KEY_PATH")
  yield
ensure
  ENV["APP_STORE_CONNECT_API_KEY_PATH"] = saved if saved
end

# ── Helper: prossimo build number ────────────────────────────────────────────
# LA FONTE DI VERITÀ È APP STORE CONNECT, NON IL DISCO. Vedi CLAUDE.md
# "Protocollo versioni e build number" — non sostituire con un contatore locale.
#
# Prende il build number più alto già esistente per questo app identifier su
# TUTTI i version train e ci somma 1. Considerare tutti i train (e non solo
# quello della marketing version corrente) evita che i numeri ripartano da capo
# quando la marketing version cambia, cosa che Apple rifiuterebbe.
#
# Si contano anche i build in stato FAILED/INVALID: un numero già usato resta
# bruciato anche se quel build non è mai diventato utilizzabile.
#
# Se la query fallisce la lane si FERMA: nessun fallback su un valore locale,
# che tra una sessione e l'altra resta indietro e produce collisioni.
def next_build_number
  Spaceship::ConnectAPI.token = spaceship_token

  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("App #{APP_IDENTIFIER} non trovata su App Store Connect.") if app.nil?

  builds  = Spaceship::ConnectAPI::Build.all(app_id: app.id)
  highest = builds.map { |b| b.version.to_i }.max || 0

  UI.message("Build number più alto su App Store Connect: #{highest} (#{builds.count} build totali)")
  highest + 1
rescue StandardError => e
  UI.user_error!(
    "Impossibile determinare il prossimo build number da App Store Connect: #{e.message}\n" \
    "La lane si ferma di proposito: senza il numero remoto non si può garantire " \
    "un build number più alto dell'ultimo accettato, e un fallback locale " \
    "rischierebbe una collisione. Ripristina la connessione o le credenziali e riprova."
  )
end

# Token Spaceship dalla stessa API key usata dalle altre lane.
def spaceship_token
  key_id    = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]

  if (content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]) && !content.empty?
    Spaceship::ConnectAPI::Token.create(
      key_id:                key_id,
      issuer_id:             issuer_id,
      key:                   content,
      is_key_content_base64: !content.include?("BEGIN PRIVATE KEY"),
    )
  else
    path = File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "~/AuthKey.p8")
    UI.user_error!("API key non trovata: #{path}") unless File.exist?(path)
    Spaceship::ConnectAPI::Token.create(key_id: key_id, issuer_id: issuer_id, filepath: path)
  end
end

platform :ios do
  # ── Lane: setup_signing ────────────────────────────────────────────────────
  # Crea (prima volta) o riallinea il provisioning profile App Store per
  # com.scabo.click-trivia, riusando il certificato Distribution già presente in
  # lumar-lounge-certs, e lo ripusha cifrato con MATCH_PASSWORD.
  #
  # Da eseguire UNA volta (o su una macchina nuova). L'uso quotidiano è readonly.
  desc "Crea/riallinea il provisioning profile App Store via Match (readonly: false)"
  lane :setup_signing do
    api_key = asc_api_key
    without_api_key_path_env do
      match(
        type:           "appstore",
        app_identifier: APP_IDENTIFIER,
        git_url:        CERTS_GIT_URL,
        storage_mode:   "git",
        team_id:        TEAM_ID,
        api_key:        api_key,
        readonly:       false,
      )
    end
    UI.success("Profilo App Store per #{APP_IDENTIFIER} allineato su #{CERTS_GIT_URL}")
  end

  # ── Lane: fetch_signing ────────────────────────────────────────────────────
  # Recupera e installa certificato + profilo SENZA rigenerare nulla.
  # È la modalità sicura da usare di default e su macchine già configurate.
  desc "Recupera e installa certificato e profilo esistenti (readonly)"
  lane :fetch_signing do
    api_key = asc_api_key
    without_api_key_path_env do
      match(
        type:           "appstore",
        app_identifier: APP_IDENTIFIER,
        git_url:        CERTS_GIT_URL,
        storage_mode:   "git",
        team_id:        TEAM_ID,
        api_key:        api_key,
        readonly:       true,
      )
    end
    UI.success("Certificato e profilo installati in locale (nessuna rigenerazione)")
  end

  # ── Lane: next_build ───────────────────────────────────────────────────────
  # Diagnostica in sola lettura: stampa che build number userebbe il prossimo
  # upload, senza costruire né caricare nulla.
  desc "Mostra il build number che userebbe il prossimo upload (sola lettura)"
  lane :next_build do
    UI.success("Prossimo build number: #{next_build_number}")
  end

  # ── Lane: build_only ───────────────────────────────────────────────────────
  # Archive + export firmati per l'App Store, senza upload. Utile per verificare
  # che la firma di distribuzione funzioni prima di pubblicare qualcosa.
  desc "Archive + export firmati App Store, senza upload"
  lane :build_only do
    fetch_signing
    # Nessun build number: l'IPA prodotto qui serve solo a verificare che la
    # firma funzioni e non viene mai caricato, quindi resta il
    # CURRENT_PROJECT_VERSION del progetto. Così la verifica locale non dipende
    # dalla rete e non consuma una query ad App Store Connect.
    archive_and_export
    UI.success("IPA firmato pronto in #{EXPORT_PATH} (nessun upload effettuato)")
  end

  # ── Lane: testflight_upload ────────────────────────────────────────────────
  # Build → archive → export → upload TestFlight in un colpo solo.
  desc "Build, archive, export e upload su TestFlight"
  lane :testflight_upload do
    # 1. Certificati in sola lettura (devono già esistere nel repo certs).
    fetch_signing

    # 2. Build number: massimo esistente su App Store Connect + 1.
    # NB: si ignora di proposito l'env condiviso SCABO_BUILD_NUMBER (valore fisso,
    # romperebbe l'incremento dal secondo upload).
    build_number = next_build_number.to_s
    UI.message("Build number di questo upload: #{build_number}")

    archive_and_export(build_number: build_number)

    # 4. Upload su TestFlight con altool + API Key.
    ipa = Dir.glob(File.join(EXPORT_PATH, "*.ipa")).first
    UI.user_error!("Nessun .ipa prodotto in #{EXPORT_PATH}") unless ipa
    ensure_altool_key
    sh(
      "xcrun", "altool", "--upload-app",
      "-f", ipa,
      "-t", "ios",
      "--apiKey",    ENV["APP_STORE_CONNECT_API_KEY_ID"],
      "--apiIssuer", ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    )
    UI.success("Upload TestFlight completato: #{File.basename(ipa)}")
  end

  # ── Helper condiviso: archive + export ─────────────────────────────────────
  private_lane :archive_and_export do |options|
    # build_number assente = non si sovrascrive CURRENT_PROJECT_VERSION e vale
    # quello del progetto (caso build_only, che non carica nulla).
    build_number = options[:build_number]

    FileUtils.rm_rf(BUILD_DIR)
    FileUtils.mkdir_p(BUILD_DIR)

    # Archive — xcodebuild diretto, niente -destination, piattaforma device.
    # Il progetto è SDKROOT=auto e dichiara anche macosx tra i SUPPORTED_PLATFORMS:
    # qui lo si restringe a iphoneos perché l'archivio deve essere iOS.
    #
    # Il build number si passa SOLO da riga di comando: il pbxproj non viene mai
    # riscritto, così non resta a disco uno stato che la sessione dopo trova
    # indietro rispetto ad App Store Connect.
    archive_args = [
      "xcodebuild", "archive",
      "-project",       PROJECT_PATH,
      "-scheme",        SCHEME,
      "-configuration", "Release",
      "-archivePath",   ARCHIVE_PATH,
      "SUPPORTED_PLATFORMS=iphoneos",
      "SUPPORTS_MACCATALYST=NO",
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=Apple Distribution",
      "PROVISIONING_PROFILE_SPECIFIER=#{PROFILE_NAME}",
    ]
    archive_args << "CURRENT_PROJECT_VERSION=#{build_number}" if build_number

    sh(*archive_args)

    # Export dell'IPA firmato per l'App Store.
    export_plist = File.join(BUILD_DIR, "ExportOptions.plist")
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store</string>
        <key>teamID</key><string>#{TEAM_ID}</string>
        <key>signingStyle</key><string>manual</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>#{APP_IDENTIFIER}</key><string>#{PROFILE_NAME}</string>
        </dict>
        <key>uploadSymbols</key><true/>
        <key>destination</key><string>export</string>
      </dict>
      </plist>
    PLIST

    sh(
      "xcodebuild", "-exportArchive",
      "-archivePath",        ARCHIVE_PATH,
      "-exportPath",         EXPORT_PATH,
      "-exportOptionsPlist", export_plist,
    )
  end
end
